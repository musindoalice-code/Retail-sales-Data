{
  "datasets": [
    {
      "name": "retail_sales",
      "displayName": "Retail Sales Data",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  _c0 AS transaction_id,\n  CAST(_c1 AS DATE) AS date,\n  _c2 AS customer_id,\n  _c3 AS gender,\n  CAST(_c4 AS INT) AS age,\n  _c5 AS product_category,\n  CAST(_c6 AS INT) AS quantity,\n  CAST(_c7 AS DECIMAL(10,2)) AS price_per_unit,\n  CAST(_c8 AS DECIMAL(10,2)) AS total_amount\nFROM sales.default.sales_retail_dataset WHERE _c0 != 'Transaction ID'\n",
        "dimensions": [
          {
            "name": "date",
            "expr": "date"
          },
          {
            "name": "product_category",
            "expr": "product_category"
          },
          {
            "name": "gender",
            "expr": "gender"
          },
          {
            "name": "age_group",
            "expr": "CASE WHEN age < 25 THEN 'Under 25' WHEN age BETWEEN 25 AND 34 THEN '25-34' WHEN age BETWEEN 35 AND 44 THEN '35-44' WHEN age BETWEEN 45 AND 54 THEN '45-54' ELSE '55+' END"
          },
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "month",
            "expr": "DATE_TRUNC('month', date)"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(total_amount)"
          },
          {
            "name": "total_transactions",
            "expr": "COUNT(*)"
          },
          {
            "name": "total_quantity_sold",
            "expr": "SUM(quantity)"
          },
          {
            "name": "avg_transaction_value",
            "expr": "AVG(total_amount)"
          },
          {
            "name": "unique_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "avg_items_per_transaction",
            "expr": "AVG(quantity)"
          }
        ]
      }
    }
  ],
